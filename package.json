{
  "name": "realtime-db-sync-pipeline",
  "version": "1.0.0",
  "description": "High-throughput reactive event pipeline synchronizing CouchDB mutations to Redis and Elasticsearch",
  "main": "dist/main.sync.js",
  "scripts": {
    "infra:up": "docker-compose up -d",
    "infra:down": "docker-compose down",
    "start:sync": "ts-node src/main.sync.ts",
    "build": "nest build -p tsconfig.build.json",
    "start": "ts-node src/main.sync.ts",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.sync.ts",
    "start:prod": "node dist/main.sync",
    "seed": "ts-node scripts/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "axios": "^1.8.4",
    "cli-progress": "^3.12.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.6.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@types/cli-progress": "^3.11.5",
    "@types/node": "^20.3.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
